NODE_ENV=development
PORT=3000

# PostgreSQL — app_user for application (RLS enforced), superuser for migrations only
DATABASE_URL=postgres://app_user:app_user_password@localhost:5432/restaurant_saas
DATABASE_URL_ADMIN=postgres://restaurant:restaurant@localhost:5432/restaurant_saas

# Redis
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=change-me-in-production
GATEWAY_ENCRYPTION_KEY=change-me-32-byte-hex-key-here

# Logging
LOG_LEVEL=info

# Email (Resend) — optional; email sending is disabled when unset
# RESEND_API_KEY=re_your_key_here
